# Supabase / Laravel DB configuration (Option A)
# Copy this to .env and fill values before running the app.

# Supabase project URL and keys
SUPABASE_URL=https:
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection details for Laravel (Supabase Postgres)
SUPABASE_DB_HOST=db.your-project.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_DATABASE=postgres
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=gCnALYAuLZUTRILH

# Laravel DB (use Supabase Postgres)
DB_CONNECTION=pgsql
DB_HOST=${SUPABASE_DB_HOST}
DB_PORT=${SUPABASE_DB_PORT}
DB_DATABASE=${SUPABASE_DB_DATABASE}
DB_USERNAME=${SUPABASE_DB_USERNAME}
DB_PASSWORD=${SUPABASE_DB_PASSWORD}

# Optional: enable server-minted JWT custom claims (role/unit_id)
# If true, your server should mint short-lived JWTs including `role` and `unit_id` claims.
SUPABASE_MINT_JWT=false

# Default role assigned to new signups (used by the DB trigger/seed)
SUPABASE_DEFAULT_ROLE=org_rep

# Notes:
# - Never commit real keys to source control.
# - Keep SUPABASE_SERVICE_ROLE_KEY server-only (store in server envs, not in frontend).
# - After populating this file: run `composer dump-autoload`, run SQL from sql/supabase_rbac.sql, then run artisan seeder.
